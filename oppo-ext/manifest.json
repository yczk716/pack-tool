{
  "manifest_version": 3,
  "name": "OPPO 登录态回传助手",
  "version": "1.0.0",
  "description": "把浏览器里 OPPO 开放平台的登录 cookie 一键回传到批量验证工具（网页按钮触发 / 每 30 分钟自动回传），全程无需下载任何脚本。",
  "key": "",
  "permissions": ["cookies"],
  "host_permissions": [
    "*://*.oppomobile.com/*",
    "*://*.oppo.com/*",
    "http://101.43.50.231:8000/*"
  ],
  "externally_connectable": {
    "matches": ["http://101.43.50.231:8000/*"]
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OPPO 登录态回传"
  }
}
